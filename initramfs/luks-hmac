#!/bin/sh

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

LUKS_DIR="/root/luks"
DEST_LUKS_DIR="${DESTDIR}/root/luks"

# Create destination directory
mkdir -p "$DEST_LUKS_DIR"

# Copy authentication data
cp "$LUKS_DIR/master.key" "$DEST_LUKS_DIR/master.key"
cp "$LUKS_DIR/expected_hmac" "$DEST_LUKS_DIR/expected_hmac"

# Copy executables
copy_exec "$LUKS_DIR/hmac_check" /root/luks/hmac_check
copy_exec "$LUKS_DIR/hmac_getkey.sh" /root/luks/hmac_getkey.sh
copy_exec /usr/bin/openssl

# Set file permissions
chmod 600 "$DEST_LUKS_DIR/master.key"
chmod 600 "$DEST_LUKS_DIR/expected_hmac"
chmod 700 "$DEST_LUKS_DIR/hmac_check" 2>/dev/null || true
chmod 700 "$DEST_LUKS_DIR/hmac_getkey.sh" 2>/dev/null || true